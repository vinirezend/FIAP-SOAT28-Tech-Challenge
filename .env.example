# Copie para .env e ajuste os valores (o .env não deve ser commitado)
ASPNETCORE_ENVIRONMENT=Development
API_PORT=8080
POSTGRES_DB=oficina
POSTGRES_USER=oficina
POSTGRES_PASSWORD=oficina
POSTGRES_PORT=5432
# Pasta com scripts .sql/.sh executados na primeira inicialização do banco
DB_INIT_SCRIPTS_PATH=./database/init
